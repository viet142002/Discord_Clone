datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Platform {
    WEB
    MOBILE
}

enum ChannelType {
    VOICE
    TEXT
}

model User {
    id        String     @id @default(cuid())
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    email     String     @unique
    name      String
    password  String
    members   Member[]
    sessions  Session[]
    roles     UserRole[]
    messages  Message[]
    mentions  Mention[]
}

model Session {
    id       String   @id @default(cuid())
    device   String
    platform Platform
    userId   String
    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, platform])
}

model Server {
    id          String    @id @default(cuid())
    name        String
    iconUrl     String
    description String
    members     Member[]
    channels    Channel[]
    roles       Role[]
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

model Member {
    id       String   @id @default(cuid())
    joinedAt DateTime @default(now())
    userId   String
    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
    serverId String

    @@unique([userId, serverId])
}

model Channel {
    id                 String                  @id @default(cuid())
    name               String
    type               ChannelType             @default(TEXT)
    isPrivate          Boolean                 @default(false)
    serverId           String
    server             Server                  @relation(fields: [serverId], references: [id], onDelete: Cascade)
    channelPermissions ChannelRolePermission[]
    messages           Message[]
    createdAt          DateTime                @default(now())
    updatedAt          DateTime                @updatedAt
}

model Role {
    id                 String                  @id @default(cuid())
    name               String
    serverId           String
    isOwner            Boolean                 @default(false)
    server             Server                  @relation(fields: [serverId], references: [id], onDelete: Cascade)
    users              UserRole[]
    channelPermissions ChannelRolePermission[]
}

model UserRole {
    id     String @id @default(cuid())
    role   Role   @relation(fields: [roleId], references: [id])
    roleId String
    user   User   @relation(fields: [userId], references: [id])
    userId String

    @@unique([roleId, userId])
}

model ChannelRolePermission {
    id        String   @id @default(cuid())
    role      Role?    @relation(fields: [roleId], references: [id], onDelete: Cascade)
    roleId    String?
    channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
    channelId String?
    canView   Boolean  @default(true)
    canSend   Boolean  @default(true)
    canManage Boolean  @default(false)

    @@unique([roleId, channelId])
}

model Message {
    id        String    @id @default(cuid())
    content   String
    mentions  Mention[]
    sender    User      @relation(fields: [senderId], references: [id])
    senderId  String
    channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
    channelId String
    replyToId String?
    replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
    replies   Message[] @relation("MessageReply")
    createdAt DateTime  @default(now())
}

model Mention {
    id        String      @id @default(cuid())
    message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
    messageId String
    user      User?       @relation(fields: [userId], references: [id])
    userId    String?
    type      MentionType
}

enum MentionType {
    ALL
    USER
}
